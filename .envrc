export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

# JVM que roda o Gradle. A compilação usa o toolchain Zulu 27 (gradle.properties:
# javaToolchainVersion) e gera bytecode 17 (javaRelease).
sdk use java 26.0.1-zulu

PATH_add "$JAVA_HOME/bin"
PATH_add "`pwd`/bin"

export JAVA_HOME
