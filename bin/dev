#!/bin/bash

case "$1" in
  "install")
    echo "::> Build, test and publish griffon-mini to maven local"
    ./gradlew build publishToMavenLocal
    ;;
  "maven-publish")
    echo "::> Publish artefacts to maven local.."
    ./gradlew publishToMavenLocal
    ;;
  "clean")
    echo "::> Clean gradle project"
    ./gradlew clean
    ;;
  "run-test")
    echo "::> Run smoke test app in ./test/app"
    (cd test/app && ../../gradlew -p . run -Dgriffon.smoke=true)
    ;;
  "run-app")
    echo "::> Run test app in ./test/app"
    (cd test/app && ../../gradlew -p . run)
    ;;
  *)
    echo "Usage:"
    echo "  dev [option]"
    echo "Options:"
    echo "  install        Build, test and publish to maven local"
    echo "  maven-publish  Publish to maven local"
    echo "  clean          Clean project"
    echo "  run-test       Run ./test/app smoke test (starts and exits)"
    echo "  run-app        Run ./test/app"
esac
