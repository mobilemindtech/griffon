plugins {
    id 'java'
    id 'groovy'
    id 'idea'
    id 'application'
    id 'com.gradleup.shadow' version '9.4.1'
}

group = 'br.com.mobilemind'
version = '1.0-SNAPSHOT'

repositories {
    mavenLocal()
    mavenCentral()
    maven { url 'https://raw.githubusercontent.com/mobilemindtech/m2/master' }
    maven { url 'https://repo1.maven.org/maven2' }
    maven { url "https://download.java.net/maven/2/" }            
    maven { url "https://mvnrepository.com/artefact" }
    maven { url "https://repository.jboss.org/nexus/content/groups/public/" }
    maven { url "https://maven.java.net/content/repositories/public/" }    
}



dependencies {
    implementation 'org.apache.groovy:groovy-all:6.0.0-alpha-1'
    implementation 'org.codehaus.griffon:griffon-rt:1.6.0-SNAPSHOT'
    implementation 'org.codehaus.griffon:griffon-cli:1.6.0-SNAPSHOT'


    // Injeta uma ponte moderna compatível com o Java / Groovy atual
    implementation 'org.slf4j:slf4j-api:2.0.13'
    implementation 'org.slf4j:slf4j-simple:2.0.13'
    implementation 'commons-lang:commons-lang:2.6'
    // 2. Por garantia, adicione também no escopo de compilação geral
    compileOnly 'org.ow2.asm:asm:9.7'

    
    /// LIB JARS



    /// PLUGINS JARS

    implementation files('C:/Users/dev/.griffon/1.6.0-SNAPSHOT/projects/app/plugins/swing-1.4.0/dist/griffon-swing-runtime-1.4.0.jar')
    implementation files('C:/Users/dev/.griffon/1.6.0-SNAPSHOT/projects/app/plugins/swing-1.4.0/dist/griffon-swing-compile-1.4.0.jar')
}

tasks.withType(JavaCompile) {
    options.release = 25
    options.compilerArgs << '--add-opens=java.base/java.lang=ALL-UNNAMED'
}

sourceSets {
    main {
        groovy {
            srcDirs = [
                'griffon-app/conf',
                'griffon-app/controllers',
                'griffon-app/models',
                'griffon-app/views',
                'griffon-app/services',
                'griffon-app/lifecycle',
                'src/main/java',
                'src/main/groovy'
            ]
        }
        resources {
            // O PULO DO GATO: Mapeamos a pasta 'conf' separadamente para que seu
            // conteúdo caia direto na raiz do JAR / Classpath, sem o prefixo "conf/"
            srcDirs = [
                'griffon-app/resources',
                'griffon-app/i18n',
                'src/main/resources'
            ]
        }
    }
}


tasks.withType(GroovyCompile) {
    groovyOptions.optimizationOptions.indy = true
    groovyOptions.fork = true
    groovyOptions.forkOptions.with {
        jvmArgs = [
            '--add-opens=java.base/java.lang=ALL-UNNAMED',
            '--add-opens=java.base/java.util=ALL-UNNAMED',
            "-Dgriffon.compiler.project.name=${project.name}".toString(),
            "-Dgriffon.compiler.basedir=${project.projectDir.absolutePath}".toString(),
            "-Dgriffon.compiler.verbose=true",
            "-Dgriffon.compiler.gradle=true"
        ]
    }
}

// 1. Task para gerar o griffon-artifacts.properties
tasks.register('generateGriffonArtifactsProperties') {
    description = "Generate file META-INF/griffon-artifacts.properties with Controllers, Models, Views and Services"
    group = "build"

    // Define os caminhos de entrada e saída para o cache do Gradle
    def griffonAppDir = file("griffon-app")
    def outputDir = file("${buildDir}/resources/main/META-INF")

    inputs.dir griffonAppDir
    outputs.dir outputDir

    doLast {
        def artifactPaths = [
            [type: "model", path: "models", suffix: "Model"],
            [type: "view", path: "views", suffix: "View"],
            [type: "controller", path: "controllers", suffix: "Controller"],
            [type: "service", path: "services", suffix: "Service"]
        ]

        def artifacts = [:]

        if (griffonAppDir.exists()) {
            griffonAppDir.eachFileRecurse { File file ->
                if (file.isFile() && file.name.endsWith(".groovy")) {
                    // Normaliza caminhos tirando a raiz para mapear o pacote clássico
                    def relativePath = file.absolutePath.substring(griffonAppDir.absolutePath.length())
                    // Corrige separadores de sistema operacional para barras normais temporariamente
                    def normalizedPath = relativePath.replace(File.separator, "/")

                    artifactPaths.each { entry ->
                        // Verifica se o arquivo pertence à pasta do artefato (ex: /controllers/AppController.groovy)
                        if (normalizedPath.contains("/${entry.path}/")) {
                            // Extrai o nome do pacote + classe baseado na estrutura interna
                            def idx = normalizedPath.indexOf("/${entry.path}/") + entry.path.length() + 2
                            def classPath = normalizedPath.substring(idx)
                            def klass = classPath.replace("/", ".").replaceAll(/\.groovy$/, "")

                            if (entry.suffix) {
                                if (klass.endsWith(entry.suffix)) {
                                    if (!artifacts[entry.type]) artifacts[entry.type] = []
                                    artifacts[entry.type] << klass
                                }
                            } else {
                                if (!artifacts[entry.type]) artifacts[entry.type] = []
                                artifacts[entry.type] << klass
                            }
                        }
                    }
                }
            }
        }

        if (artifacts) {
            outputDir.mkdirs()
            File artifactFile = file("${outputDir}/griffon-artifacts.properties")
            artifactFile.withPrintWriter("UTF-8") { writer ->
                artifacts.each { type, list ->
                    // O formato precisa exatamente das aspas simples e delimitado por vírgula
                    writer.println("${type} = '${list.join(',')}'")
                }
            }
            println "✅ [GRADLE META-INF] 'griffon-artifacts.properties' successfully generated!"
        }
    }
}

// 2. Task para gerar o griffon-addons.properties
tasks.register('generateGriffonAddonsProperties') {
    description = "Generate file META-INF/griffon-addons.properties with plugins and graphical toolkit"
    group = "build"

    def outputDir = file("${buildDir}/resources/main/META-INF")
    outputs.dir outputDir

    doLast {
        Map addons = [:]

        // Aqui nós simulamos os plugins coletando as dependências do próprio Gradle
        // em vez de varrer a pasta .griffon clássica antiga
        project.configurations.runtimeClasspath.resolvedConfiguration.resolvedArtifacts.each { artifact ->
            def id = artifact.moduleVersion.id
            // Verifica se o JAR se trata de um addon ou plugin do runtime do Griffon
            if (id.name.startsWith("griffon-") && id.name.endsWith("-runtime")) {
                def pluginName = id.name.replaceAll(/^griffon-/, "").replaceAll(/-runtime$/, "")
                addons[pluginName] = id.version
            } else if (id.name.contains("-addon-") || id.name.startsWith("griffon-swing")) {
                def pluginName = id.name.replaceAll(/^griffon-/, "")
                addons[pluginName] = id.version
            }
        }

        // Garante que o toolkit swing sempre esteja explicitado (conforme a lógica do Ant)
        if (!addons.containsKey("swing")) {
            addons["swing"] = "1.4.0" // Altere para a versão do seu swing se necessário
        }

        if (addons) {
            outputDir.mkdirs()
            File addonFile = file("${outputDir}/griffon-addons.properties")
            addonFile.withPrintWriter("UTF-8") { writer ->
                addons.each { name, version ->
                    writer.println("${name} = ${version}")
                }
            }
            println "✅ [GRADLE META-INF] 'griffon-addons.properties' successfully generated!"
        }
    }
}

processResources.dependsOn generateGriffonArtifactsProperties, generateGriffonAddonsProperties

application {
    mainClass = 'griffon.swing.SwingApplication' // Ou a sua classe main customizada
}

run {
    systemProperty 'griffon.env', 'dev'
    workingDir = rootProject.projectDir
    standardInput = System.in
    standardOutput = System.out
    errorOutput = System.err
    classpath = sourceSets.main.runtimeClasspath
    jvmArgs = [
        '--add-opens=java.base/java.lang=ALL-UNNAMED',
        '--add-opens=java.base/java.util=ALL-UNNAMED',
        '-Djava.awt.headless=false',
        "-Dgriffon.application.name=${project.name}".toString()
    ]

}

shadowJar {
    archiveClassifier.set('dist')

    // CORREÇÃO DAS EXTENSÕES: Mescla os arquivos do Groovy 6 automaticamente!
    mergeServiceFiles {
        include 'META-INF/groovy/org.codehaus.groovy.runtime.ExtensionModule'
    }
}